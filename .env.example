# Copy this file to .env and fill in real local values. Never commit .env.

# Anthropic API key used only by the backend for the single extraction call.
# The frontend never sees this value.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override the model used for extraction.
ANTHROPIC_MODEL=claude-sonnet-5

# Local PostgreSQL connection string (matches docker-compose.yml defaults).
DATABASE_URL=postgresql://cibc_demo:cibc_demo@localhost:5433/cibc_demo

# Origin the backend will allow via CORS (the local Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173
